# Copy to .env and adjust as needed.

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=drug_reviews
MONGO_COLLECTION=reviews

# Source MySQL (used by the backfill script only)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=drug_recomdendation

# Backfill
BACKFILL_BATCH_SIZE=500
